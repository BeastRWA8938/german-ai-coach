{
  "name": "projektdeutsch-ai",
  "private": true,
  "version": "0.4.0",
  "description": "AI-powered German learning coach with CEFR-aligned practice and local progress tracking.",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.17.0",
    "npm": ">=11.17.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint src",
    "lint:eslint": "eslint \"src/**/*.{js,jsx}\" --max-warnings=0",
    "test": "node --test \"src/**/*.test.js\"",
    "check": "npm run lint && npm run test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "oxlint": "^1.70.0",
    "vite": "^8.0.16"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.1.2"
  }
}
